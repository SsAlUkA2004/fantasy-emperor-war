rules_version = '2';

// กฎสำหรับเฟส 0 — ปิดทุกอย่างไว้ก่อน
// หน้าไตเติลจะขึ้นว่า "เชื่อมต่อสำเร็จ" พร้อมบอกว่าโดนกฎปฏิเสธ ซึ่งคือผลที่ถูกต้อง
// ค่อยเปิดสิทธิ์ทีละคอลเลกชันตอนเฟสถัด ๆ ไป
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
